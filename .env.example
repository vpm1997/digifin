# Local API server
PORT=8787

# Optional — enables Claude-powered audits and dispute letters.
# Without a key the deterministic rule engine and letter templates are used.
ANTHROPIC_API_KEY=

# Optional model override
CLAUDE_MODEL=claude-sonnet-4-5

# Optional allowlist for the API (comma-separated). Unset = allow any origin.
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Frontend build
# ---------------------------------------------------------------------------

# Serve the app under a sub-path (GitHub Pages project sites: /<repo-name>/)
VITE_BASE_PATH=/

# Set to "true" to run audits fully in the browser (no API needed).
# Required for GitHub Pages.
VITE_OFFLINE_AUDIT=

# Point the UI at a separately hosted API, e.g. https://my-api.vercel.app
VITE_API_BASE_URL=
